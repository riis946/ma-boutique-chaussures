datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  nom       String
  prenom    String
  email     String   @unique
  password  String
  role      String   @default("client")
  orders    Order[]
  createdAt DateTime @default(now())
}

model Product {
  id          Int      @id @default(autoincrement())
  nom         String
  description String?
  prix        Float
  stock       Int
  image       String?
  createdAt   DateTime @default(now())
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  total     Float
  status    String   @default("en_attente")
  createdAt DateTime @default(now())
}